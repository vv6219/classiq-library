              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardHUDResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/presentation/frames/{run_id}": {
      "get": {
        "tags": [
          "Presentation HUD & Simulation Streaming"
        ],
        "summary": "Get Simulation Animation Frames",
        "description": "Retrieves 10Hz/20Hz time-series vehicle poses and chute queue depths.",
        "operationId": "getSimulationFrames",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 200
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimulationFramesResponse"
                }
