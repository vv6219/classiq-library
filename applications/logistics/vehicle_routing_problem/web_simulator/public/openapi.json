            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuantumDistanceMatrixResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/quantum/qaoa-subtour": {
      "post": {
        "tags": [
          "Quantum Co-Processor (Classiq)"
        ],
        "summary": "Solve QAOA VRP Subtour Circuit",
        "description": "Synthesizes parameterized QAOA Hamiltonian and finds optimal node sequence.",
        "operationId": "solveQAOASubtour",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QAOASubtourRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QAOASubtourResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/benchmarks/compare": {
      "post": {
        "tags": [
          "Comparative Benchmarks"
        ],
        "summary": "Run 4-Way Algorithmic Benchmark",
        "description": "Executes comparative benchmark across FIFO, Hard K-Means, Classical SC-QFCM, and Classiq Quantum.",
        "operationId": "runComparativeBenchmark",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BenchmarkRunRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BenchmarkComparisonResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/benchmarks/regression-test": {
      "post": {
        "tags": [
          "Comparative Benchmarks"
        ],
        "summary": "Detect Performance Regression",
        "description": "Compares candidate execution run against baseline and detects degradation.",
        "operationId": "detectRegression",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegressionTestRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegressionTestResponse"
                }
              }
            }
          }
        }
      }
