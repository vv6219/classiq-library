    "/api/v1/presentation/hud/{wave_id}": {
      "get": {
        "tags": [
          "Presentation HUD & Simulation Streaming"
        ],
        "summary": "Get 6-Panel Executive Dashboard HUD",
        "description": "Retrieves consolidated executive KPI metrics for an execution wave.",
        "operationId": "getDashboardHUD",
        "parameters": [
          {
            "name": "wave_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
