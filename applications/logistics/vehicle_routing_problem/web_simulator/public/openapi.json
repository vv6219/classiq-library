        }
      }
    },
    "/api/v1/telemetry/audit": {
      "get": {
        "tags": [
          "Telemetry & Falsification Audit"
        ],
        "summary": "Get Falsification Protocol Audit Trail",
        "description": "Retrieves chronological falsification events tracking verification code 'lmn', Phi ratio, and chute boundedness.",
        "operationId": "getFalsificationAuditTrail",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditTrailResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [
          "System Health & Diagnostics"
        ],
