{
  "openapi": "3.1.0",
  "info": {
    "title": "Industrial Multi-Tier Warehouse Optimization Engine (DispatchEngine) API",
    "version": "1.0.0",
    "description": "### Enterprise REST & Streaming API for Extended Rich Multi-Depot VRPTW with Classiq Quantum Co-Processor Acceleration ($\\mathcal{P}_{\\text{ER-MD-VRPTW-3D-HRI-Q}}$).\n\n#### Core Capabilities:\n- **Multi-Archetype Synthetic Mocking**: 7 industrial warehouse scenario archetypes (Pareto Hot Zone, Cross-Dock, Surge, HAZMAT Segregation, HRI Congestion, Enterprise Scale up to 35,000 orders).\n- **4-Tier Optimization Hierarchy**: Batching (Tier 1), 3D Containerization (Tier 2), Routing (Tier 3), Kinematics (Tier 4).\n- **Classiq Quantum Acceleration**: Swap-Test fidelity kernels, ZZ feature maps, parameterized QAOA subtour synthesis, Shannon entropy & circuit profiling.\n- **Invariant Validation & Recourse**: Mathematical Gates 1-4 with automated Benders cuts.\n- **Presentation & Streaming**: 10Hz/20Hz simulation frames, 6-panel Executive HUD, and Server-Sent Events (SSE).\n- **4-Way Benchmark Comparator**: FIFO vs Hard K-Means vs Classical SC-QFCM vs Classiq Quantum.\n- **Falsification Protocol**: Empirical verification tracking enforced code `lmn`.",
    "contact": {
      "name": "Classiq Logistics Team",
      "url": "https://classiq.io"
    },
    "license": {
      "name": "Apache 2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0.html"
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080",
      "description": "Local Standalone DispatchEngine Server"
    },
    {
      "url": "http://localhost:8000",
      "description": "FastAPI ASGI Server"
    }
  ],
  "tags": [
    {
      "name": "Scenarios & Mock Data Engine",
      "description": "Synthetic warehouse generation, canonical presets, live sample previews, and WMS order ingestion."
    },
    {
      "name": "Wave Orchestration",
      "description": "Master wave dispatch pipeline coordinating Tiers 1-4 and Invariant Validation Gates."
    },
    {
      "name": "Isolated Tier Solvers",
      "description": "Direct step-through execution and unit testing for Tiers 1, 2, 3, and 4."
    },
    {
      "name": "Invariant Validation Gates & Recourse",
      "description": "Verification of physical, temporal, and spatial constraints with Benders cut generation."
    },
    {
      "name": "Quantum Co-Processor (Classiq)",
      "description": "Swap-Test state fidelity, ZZ feature maps, QAOA subtour optimization, and quantum circuit telemetry."
    },
    {
      "name": "Comparative Benchmarks",
      "description": "4-Way algorithmic benchmarking and automated regression detection."
    },
    {
      "name": "Presentation HUD & Simulation Streaming",
      "description": "6-panel executive dashboard HUD, simulation frames time-series, and SSE streaming."
    },
    {
      "name": "Telemetry & Falsification Audit",
      "description": "Distributed OpenTelemetry spans and formal audit trail recording verification code 'lmn'."
    },
    {
      "name": "System Health & Diagnostics",
      "description": "Engine health, Classiq SDK readiness, and OpenAPI schema definitions."
    }
  ],
  "paths": {
    "/api/v1/scenarios/archetypes": {
      "get": {
        "tags": [
          "Scenarios & Mock Data Engine"
        ],
        "summary": "List Warehouse Scenario Archetypes",
        "description": "Retrieves the 7 available warehouse scenario archetypes with physical characteristics and stress targets.",
        "operationId": "listScenarioArchetypes",
        "responses": {
          "200": {
            "description": "List of available archetypes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArchetypeListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/scenarios/presets": {
      "get": {
        "tags": [
          "Scenarios & Mock Data Engine"
        ],
        "summary": "List Canonical Benchmark Presets",
        "description": "Returns pre-configured benchmark scenario configurations ('small-smoke-40', 'pareto-cluster-200', 'hazmat-heavy-500', 'surge-deadline-1000', 'enterprise-35k').",
        "operationId": "listCanonicalPresets",
        "responses": {
          "200": {
            "description": "Canonical presets dictionary",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "$ref": "#/components/schemas/MockScenarioCreateRequest"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/scenarios/presets/{preset_name}": {
      "post": {
        "tags": [
          "Scenarios & Mock Data Engine"
        ],
        "summary": "Generate Scenario from Preset",
        "description": "Instantly generates and persists a canonical benchmark scenario by preset key.",
        "operationId": "generateFromPreset",
        "parameters": [
          {
            "name": "preset_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "pareto-cluster-200"
            },
            "description": "Preset key identifier"
          }
        ],
        "responses": {
          "201": {
            "description": "Scenario generated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScenarioDetailResponse"
                }
              }
            }
          },
          "404": {
            "description": "Preset not found"
          }
        }
      }
    },
    "/api/v1/scenarios/mock-sample": {
      "get": {
        "tags": [
          "Scenarios & Mock Data Engine"
        ],
        "summary": "Live Sample Order Preview",
        "description": "Generates a transient live sample of 1 to 20 customer orders without writing to database, for immediate UI inspection.",
        "operationId": "previewMockSample",
        "parameters": [
          {
            "name": "archetype",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "PARETO_HOT_ZONE"
            },
            "description": "Target archetype for spatial distribution"
          },
          {
            "name": "count",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 5,
              "minimum": 1,
              "maximum": 50
            },
            "description": "Number of sample orders to preview"
          },
          {
            "name": "seed",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 42
            },
            "description": "Random seed"
          }
        ],
        "responses": {
          "200": {
            "description": "Sample orders preview array",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OrderLineSchema"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/scenarios/generate": {
      "post": {
        "tags": [
          "Scenarios & Mock Data Engine"
        ],
        "summary": "Generate Custom Synthetic Scenario",
        "description": "Synthesizes customer orders, aisle coordinates, depot states, and saves to database.",
        "operationId": "generateCustomScenario",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MockScenarioCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Custom scenario created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScenarioDetailResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/scenarios": {
      "get": {
        "tags": [
          "Scenarios & Mock Data Engine"
        ],
        "summary": "List Persisted Scenarios",
        "description": "Queries all scenarios stored in the SQLite/SQLAlchemy database with pagination.",
        "operationId": "listScenarios",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of scenario records",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ScenarioDetailResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/scenarios/{scenario_id}": {
      "get": {
        "tags": [
          "Scenarios & Mock Data Engine"
        ],
        "summary": "Get Scenario Metadata",
        "description": "Retrieves metadata, depot counts, and bounds for a specific scenario.",
        "operationId": "getScenarioById",
        "parameters": [
          {
            "name": "scenario_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Scenario metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScenarioDetailResponse"
                }
              }
            }
          },
          "404": {
            "description": "Scenario not found"
          }
        }
      }
    },
    "/api/v1/scenarios/{scenario_id}/orders": {
      "get": {
        "tags": [
          "Scenarios & Mock Data Engine"
        ],
        "summary": "Get Scenario Orders Pool",
        "description": "Queries order lines belonging to a scenario with pagination.",
        "operationId": "getScenarioOrders",
        "parameters": [
          {
            "name": "scenario_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order lines array",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OrderLineSchema"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/dispatch/waves": {
      "post": {
        "tags": [
          "Wave Orchestration"
        ],
        "summary": "Execute Synchronous Wave Dispatch",
        "description": "Executes full multi-tier dispatch across Tiers 1-4 with validation gates, Benders recourse, and database snapshot commit.",
        "operationId": "executeWaveDispatch",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WaveDispatchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Wave dispatch result with full metrics",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WaveDispatchResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/dispatch/runs": {
      "get": {
        "tags": [
          "Wave Orchestration"
        ],
        "summary": "Query Execution Runs",
        "description": "Queries historical execution runs from the database.",
        "operationId": "listExecutionRuns",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of execution runs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WaveDispatchResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
